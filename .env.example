# --- SUPABASE (auth + banco) ---
# Guia: docs/SUPABASE_SETUP.md
# SQL: supabase/migrations/20261026_vitrinex_init.sql
# Sem estas duas, o app fica em modo demo (login mock).
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- PROVEDOR LOCAL (Electron / desktop) ---
# ollama | 9router | gemini
# Ollama usa a API NATIVA (POST /api/chat), não o shim /v1.
VITE_AI_PROVIDER=ollama
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=jev:latest
# Se Ollama falhar (sem modelo, 404, timeout), tenta 9Router automaticamente
VITE_OLLAMA_FALLBACK_9ROUTER=true
VITE_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
VITE_9ROUTER_API_KEY=sk-COLE_SUA_ROUTER_API_KEY_AQUI
VITE_9ROUTER_MODEL=cx/gpt-5.6-sol

# --- CONFIGURAÇÕES DE AI (GOOGLE GEMINI) ---
VITE_GEMINI_API_KEY=sua-chave-api-gemini

# --- INTEGRAÇÃO SERPAPI (GOOGLE TRENDS) ---
VITE_SERPAPI_KEY=sua-chave-serpapi

# --- INTEGRAÇÃO HOSTINGER (BANCO MYSQL) ---
VITE_HOSTINGER_API_URL="https://seusite.com.br/api"

# --- REDES SOCIAIS (META API) ---
VITE_FB_APP_ID=seu-app-id-facebook
VITE_FB_PAGE_ID=id-da-sua-pagina
VITE_IG_USER_ID=id-da-conta-instagram
VITE_AUTH_REDIRECT_URI=http://127.0.0.1:8080
VITE_PINTEREST_APP_ID=seu-app-id-pinterest

# --- OUTRAS INTEGRAÇÕES ---
VITE_GOOGLE_DRIVE_CLIENT_ID=seu-client-id-google
VITE_CANVA_APP_ID=seu-app-id-canva
